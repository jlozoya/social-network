{
  "name": "@social-network/shared",
  "version": "2.0.0",
  "private": true,
  "description": "Contratos de dominio compartidos entre la API NestJS y la app Ionic/Angular.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
