# Dependencias
node_modules/
.pnp/
.pnp.js

# Salidas de compilación
dist/
www/
out-tsc/
build/
.angular/
*.tsbuildinfo

# Archivos subidos en desarrollo
apps/api/storage/

# Entorno: se versiona sólo el ejemplo
.env
.env.*
!.env.example

# Plataformas nativas (se regeneran con `npx cap add`)
/android
/ios
/platforms
/plugins
apps/mobile/android/
apps/mobile/ios/

# Registros y cachés
*.log
npm-debug.log*
yarn-error.log*
.npm
.eslintcache
coverage/
.nyc_output/
playwright-report/
test-results/

# Claude Code: se versiona cómo arrancar la API y la aplicación para verlas
# en el navegador; los permisos y ajustes de cada cual se quedan en su máquina.
.claude/*
!.claude/launch.json
!.claude/settings.json

# Editores y sistema operativo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp
*~
$RECYCLE.BIN/
UserInterfaceState.xcuserstate

# Ionic
.ionic/
.sourcemaps/
.sass-cache/

# Configuración de servicios de Google: lleva claves del proyecto y no la usa
# nada de la compilación actual, así que se queda en cada máquina.
apps/mobile/credentials.json
apps/mobile/google-services.json
apps/mobile/GoogleService-Info.plist

# Clave de carga de Android y contraseña cifrada con Windows DPAPI
/.android-signing/
