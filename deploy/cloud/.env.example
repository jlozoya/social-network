# Copia a deploy/cloud/.env. Este archivo sólo contiene valores de ejemplo.
# La API y la web autenticada necesitan un servidor con Docker y disco persistente.
# Sites aloja las páginas públicas de presentación, privacidad y soporte.
DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=
API_IMAGE=ghcr.io/jlozoya/social-network-api:latest
WEB_IMAGE=ghcr.io/jlozoya/social-network-web:latest

# Atlas Free: crea un usuario readWrite únicamente para social_network.
# Copia la URI de Drivers, añade /social_network y conserva sus opciones.
# Codifica los caracteres especiales de usuario/contraseña con encodeURIComponent.
# No añadas replicaSet=rs0 ni directConnection=true: corresponden al Mongo local.
DATABASE_URL=
DATABASE_POOL_SIZE=5

# Upstash Redis Free: copia la conexión de Connect > TCP (compatible con ioredis).
# rediss://default:CONTRASENA_CODIFICADA@HOST.upstash.io:6379/0
# Usa la URI TCP con TLS, no la URL HTTPS de la API REST.
# No publiques el puerto de Redis ni pongas esta URI en la app o en Sites.
REDIS_URL=

# Genera dos valores diferentes: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Genera una clave de 32 bytes y consérvala: cambiarla invalida el segundo factor.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
CORS_ORIGINS=https://app.example.com,capacitor://localhost,https://localhost

APP_NAME=Social Network
APP_TAGLINE=Comparte lo que te importa con quien te importa.
APP_DESCRIPTION=Una red social para compartir publicaciones y conversar.
APP_LOGO_URL=
APP_ICON_URL=
APP_BRAND_COLOR="#f05a22"
APP_BRAND_GRADIENT="linear-gradient(135deg, #f05a22 0%, #f7931e 100%)"
# URL pública real de Sites una vez publicado.
APP_WEBSITE=
APP_PUBLIC_MAIL=
APP_PHONE=
APP_ADDRESS=
APP_FACEBOOK=
APP_INSTAGRAM=

# El registro y la recuperación de contraseña necesitan un SMTP real.
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
SUPPORT_MAIL=

# Opcionales. Sin sus credenciales no se habilitan los proveedores correspondientes.
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FIREBASE_SERVICE_ACCOUNT=
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=production
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MXN

# Los directos quedan desactivados hasta disponer de un servidor LiveKit externo.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
