{
  "name": "@social-network/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "API GraphQL de la red social, construida con NestJS y MongoDB.",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:seed": "tsx scripts/seed.ts",
    "migrate:mongo": "tsx scripts/migrate-mysql-to-mongo.ts",
    "clean": "rimraf dist",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "migrate:social": "tsx scripts/migrate-social.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@social-network/shared": "*",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "google-auth-library": "^11.1.0",
    "graphql": "^16.14.2",
    "graphql-query-complexity": "^2.0.0",
    "graphql-upload": "^17.1.0",
    "graphql-ws": "^6.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "^2.19.1",
    "mariadb": "3.5.4",
    "mongoose": "^9.11.0",
    "nodemailer": "^10.0.15",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/graphql-upload": "^17.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
