  "devDependencies": {
    "@angular-eslint/schematics": "^22.5.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler": "^22.1.6",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/language-service": "^22.1.6",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^26.6.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "rimraf": "^6.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
